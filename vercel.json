{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/analyze-video.js": {
      "maxDuration": 30
    },
    "api/analyze-excel.js": {
      "maxDuration": 30
    },
    "api/analyze-excel-text.js": {
      "maxDuration": 30
    }
  },
  "git": {
    "deploymentEnabled": {
      "integration/agent": false
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/pages/find-solution.html"
    },
    {
      "source": "/find-solution",
      "destination": "/pages/find-solution.html"
    },
    {
      "source": "/engineers",
      "destination": "/pages/engineers.html"
    },
    {
      "source": "/messages",
      "destination": "/pages/messages.html"
    },
    {
      "source": "/login",
      "destination": "/pages/login.html"
    },
    {
      "source": "/signup",
      "destination": "/pages/signup.html"
    },
    {
      "source": "/message-vendor",
      "destination": "/pages/message-vendor.html"
    },
    {
      "source": "/engineer-claims",
      "destination": "/pages/engineer-claims.html"
    },
    {
      "source": "/client-bounty-journey",
      "destination": "/pages/client-bounty-journey.html"
    },
    {
      "source": "/robot-finder",
      "destination": "/pages/robot-finder.html"
    },
    {
      "source": "/order-confirm",
      "destination": "/pages/order-confirm.html"
    },
    {
      "source": "/:page([a-z-]+)\\.html",
      "destination": "/pages/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=()"
        }
      ]
    }
  ]
}
