# Copy to .env.local. `npx convex dev` writes CONVEX_DEPLOYMENT here itself.
# Never commit real values. Server-side secrets (e.g. LLM keys) belong in
# Convex environment variables (`npx convex env set NAME value`), not in files.
CONVEX_DEPLOYMENT=
# Public URL a plain HTML/JS frontend connects to (safe to share with teammates)
CONVEX_URL=
# Sign-in (Clerk) is configured on each Convex deployment, not in this file:
#   npx convex env set CLERK_FRONTEND_API_URL https://relevant-kingfish-8271.clerk.accounts.dev
# See docs/accounts-and-access.md.
