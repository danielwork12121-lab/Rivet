{
  "name": "rivet",
  "version": "0.1.0",
  "private": true,
  "description": "Rivet \u2014 AI robotics procurement for small trade businesses: describe the job, get ranked robots with payback computed in code, pool bounties for robots that do not exist yet.",
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "typecheck": "tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run",
    "e2e:local": "node scripts/e2e-local.mjs",
    "e2e:auth": "node scripts/e2e-auth-local.mjs",
    "e2e:auth:browser": "node scripts/browser-auth-e2e.mjs",
    "e2e:clerk": "node scripts/browser-clerk-real.mjs",
    "e2e:clerk:video": "node scripts/browser-clerk-video.mjs",
    "e2e:clerk:matching": "node scripts/browser-clerk-matching.mjs",
    "e2e:clerk:requirements": "node scripts/browser-clerk-requirements.mjs",
    "check:frontend": "node scripts/check-frontend.mjs",
    "test-data:list": "convex run maintenance:testData '{\"action\":\"list\"}'",
    "ci": "npm run typecheck && npm test && npm run check:frontend"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "convex": "^1.48.0",
    "exceljs": "^4.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.5",
    "convex-test": "^0.0.65",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielwork12121-lab/Rivet"
  },
  "engines": {
    "node": ">=20"
  }
}
